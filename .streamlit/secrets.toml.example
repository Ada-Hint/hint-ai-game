# Copy to secrets.toml locally, or paste into Streamlit Cloud's Secrets settings.
# Never commit secrets.toml.
STORAGE_BACKEND = "supabase"
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_REPLACE_WITH_YOUR_SERVER_ONLY_KEY"
HOST_PASSWORD = "replace-with-a-long-unique-password"
EVENT_CODE = "replace-with-your-event-code"
EVENT_ID = "hint-lunch-and-learn"
PUBLIC_BASE_URL = "https://YOUR-APP.streamlit.app"
